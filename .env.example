# Environment Configuration for Abhay Kumar Portfolio & CMS

# Server Port (default 3000 in unified full-stack dev / 5000 in standalone)
PORT=3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/abhay_portfolio?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Session Authentication
JWT_SECRET=super_secret_jwt_random_key_production_2026_abhay

# Client / Frontend Origin URL
CLIENT_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Default Admin Credentials (Seed / Initial Setup)
ADMIN_NAME=Abhay Kumar
ADMIN_EMAIL=admin@abhaykumar.dev
ADMIN_PASSWORD=Admin@12345
